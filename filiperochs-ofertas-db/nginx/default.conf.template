# Se so veio o header apikey (sem Authorization), usa o apikey como bearer (o Kong do Supabase faz isso).
map $http_authorization $bearer {
    default $http_authorization;
    ""      "Bearer $http_apikey";
}

# API (publicada no host, porta 58101): mesmos caminhos do supabase.co
server {
    listen 8000;
    client_max_body_size 20m;

    location /rest/v1/ {
        proxy_pass http://rest:3000/;
        proxy_set_header Authorization $bearer;
        proxy_set_header Host $host;
    }
    location /auth/v1/ {
        proxy_pass http://auth:9999/;
        proxy_set_header Host $host;
    }
    location /storage/v1/ {
        client_max_body_size 6m;
        proxy_pass http://storage:5000/;
        proxy_set_header Authorization $bearer;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Path /storage/v1;
    }
    location = /health { return 200 "ok\n"; }
    location / { return 404; }
}

# UI (atras do login do Umbrel via app_proxy): mostra URLs e chaves
server {
    listen 80;
    location / {
        default_type text/plain;
        return 200 "Ofertas DB (Postgres + PostgREST + GoTrue)\n\nAPI:      http://${UMBREL_HOST_HINT}:58101\nPostgres: ${UMBREL_HOST_HINT}:54329 (user postgres, db postgres)\n\nPOSTGRES_PASSWORD=${POSTGRES_PASSWORD}\nANON_KEY=${ANON_KEY}\nSERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}\n";
    }
}
